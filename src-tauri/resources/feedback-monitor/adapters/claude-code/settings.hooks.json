{
  "_comment": "合并进 ~/.claude/settings.json 的 hooks 段。CC 原生 hooks 格式。${FEEDBACK_DIR} 由 skills-manager 装机时替换为 feedback-monitor 安装绝对路径。",
  "hooks": {
    "PostToolUse": [
      { "matcher": "*", "hooks": [ { "type": "command", "timeout": 15, "command": "node \"${FEEDBACK_DIR}/adapters/claude-code/ingest.mjs\"" } ] }
    ],
    "PostToolUseFailure": [
      { "matcher": "*", "hooks": [ { "type": "command", "timeout": 15, "command": "node \"${FEEDBACK_DIR}/adapters/claude-code/ingest.mjs\"" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "timeout": 15, "command": "node \"${FEEDBACK_DIR}/adapters/claude-code/ingest.mjs\"" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "timeout": 10, "command": "node \"${FEEDBACK_DIR}/adapters/claude-code/ingest.mjs\"" } ] }
    ]
  }
}
